Vagrant.configure("2") do |config|
  # config.vm.define "backend" do |backend|
  #   backend.vm.box = "generic/debian12"

  #   # Configure network
  #   backend.vm.network "private_network", ip: "192.168.56.10"

  #   # --- Ansible Provisioning Section ---
  #   backend.vm.provision "ansible" do |ansible|
  #     ansible.playbook = "tib_backend_deploy.yml"
  #   end

  #   backend.vm.provider "libvirt" do |vb|
  #     # Map more CPU cores (e.g., 2 or 4 depending on your host)
  #     vb.cpus = 4

  #     # Give it more RAM (e.g., 4096MB = 4GB, or 8192MB = 8GB)
  #     vb.memory = 8192
  #     vb.machine_virtual_size = 256
  #   end
  # end

  config.vm.define "analyser" do |analyser|
    #analyser.vm.box = "generic/debian12"
    config.vm.box = "generic/rocky9"
    # Configure network
    analyser.vm.network "private_network", ip: "192.168.56.11"

    # --- Ansible Provisioning Section ---
    analyser.vm.provision "ansible" do |ansible|
      ansible.playbook = "tib_analyser_deploy.yml"
      ansible.extra_vars = {
        ansible_password: "vagrant",
        ansible_become_password: "vagrant"
      }
    end
    analyser.vm.provider "libvirt" do |vb|
      # Map more CPU cores (e.g., 2 or 4 depending on your host)
      vb.cpus = 4

      # Give it more RAM (e.g., 4096MB = 4GB, or 8192MB = 8GB)
      vb.memory = 8192
      vb.machine_virtual_size = 256
    end
  end
end