upstream tibava_backend_gunicorn {
    server backend:8000 fail_timeout=0;
}

server {
    listen 80;
    client_max_body_size 50G;
    server_name localhost;
    keepalive_timeout 5;
    merge_slashes on;

{% if script_name is defined and script_name | length > 0 %}
    # Global rewrite: prepend /{{ script_name }}/ to any incoming URL missing it
    rewrite ^/(?!{{ script_name | regex_replace('^/', '') }}/)(.*)$ {{ script_name }}/$1 last;
    
    # Backend API Proxy
    location {{ script_name }}/backend/ {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_redirect off;

        proxy_pass http://tibava_backend_gunicorn;
    }

    # Static Data Storage
    location {{ script_name }}/media/ {
        alias /data/media/;
    }

    location {{ script_name }}/thumbnails/ {
        alias /data/predictions/;
    }

    # Main Frontend Single Page App (SPA)
    location {{ script_name }}/ {
        alias /app/frontend/dist/;
        index index.html;
        try_files $uri $uri/ @fallback;
    }
{% else %}
    # Root path setup (When script_name is empty)

    location /backend/ {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_redirect off;

        proxy_pass http://tibava_backend_gunicorn;
    }

    location /media/ {
        alias /data/media/;
    }

    location /thumbnails/ {
        alias /data/predictions/;
    }

    location / {
        root /app/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
{% endif %}

    # Named fallback location
    location @fallback {
        root /app/frontend/dist;
        rewrite ^ /index.html break;
    }
}