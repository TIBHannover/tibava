upstream tibava_backend_gunicorn {
    server backend:8000 fail_timeout=0;
}

{% set prefix = SCRIPT_NAME | default('') | trim('/') %}

server {
    listen 80;
    client_max_body_size 50G;
    server_name localhost;
    keepalive_timeout 5;

    # Normalize multiple adjacent slashes into a single slash (fixes //backend issues)
    merge_slashes on;

{% if prefix | length > 0 %}
    # ==========================================
    # SUBPATH SETUP (e.g. /tibava-dev)
    # ==========================================

    # Backend API Proxy
    location /{{ prefix }}/backend/ {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Prefix /{{ prefix }};
        proxy_redirect off;

        # Strips /tibava-dev/backend/ and forwards /backend/ to Gunicorn
        # Remove trailing slash if Gunicorn expects the full path
        proxy_pass http://tibava_backend_gunicorn/backend/;
    }

    # Static Media Storage
    location /{{ prefix }}/media/ {
        alias /data/media/;
    }

    # Static Thumbnails Storage
    location /{{ prefix }}/thumbnails/ {
        alias /data/predictions/;
    }

    # SPA Frontend (Static Assets)
    location /{{ prefix }}/ {
        alias /app/frontend/dist/;
        index index.html;
        try_files $uri $uri/ /{{ prefix }}/index.html;
    }

    # Redirect root '/' to '/tibava-dev/' if accessed directly on this container
    location = / {
        return 301 /{{ prefix }}/;
    }

{% else %}
    # ==========================================
    # ROOT PATH SETUP (When SCRIPT_NAME is empty)
    # ==========================================

    location /backend/ {
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_redirect off;

        proxy_pass http://tibava_backend_gunicorn;
    }

    location /media/ {
        alias /data/media/;
    }

    location /thumbnails/ {
        alias /data/predictions/;
    }

    location / {
        root /app/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
{% endif %}
}